{
  "name": "pi-bot-connect",
  "version": "0.0.0",
  "private": true,
  "description": "Transport-agnostic messenger bridge for live pi sessions: share current work and keep going from Discord, Slack, or Telegram.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "discord",
    "slack",
    "telegram",
    "remote-control"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "docs",
    "AGENTS.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test",
    "check:watch": "vitest --watch"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.0",
    "typebox": ">=1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typebox": "^1.3.7",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
